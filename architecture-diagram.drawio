<mxfile host="app.diagrams.net">
  <diagram name="AWS Architecture" id="aws-arch-01">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Internet -->
        <mxCell id="internet" value="🌐 Internet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Internet Gateway -->
        <mxCell id="igw" value="Internet Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="680" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="VPC (10.0.0.0/16)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="200" y="280" width="1200" height="700" as="geometry" />
        </mxCell>

        <!-- AZ A -->
        <mxCell id="az-a" value="Availability Zone A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="340" width="520" height="600" as="geometry" />
        </mxCell>

        <!-- AZ B -->
        <mxCell id="az-b" value="Availability Zone B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="340" width="520" height="600" as="geometry" />
        </mxCell>

        <!-- Public Subnet A -->
        <mxCell id="pub-a" value="Public Subnet&#10;10.0.0.0/24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="440" height="220" as="geometry" />
        </mxCell>

        <!-- Private Subnet A -->
        <mxCell id="priv-a" value="Private Subnet&#10;10.0.1.0/24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="440" height="220" as="geometry" />
        </mxCell>

        <!-- Public Subnet B -->
        <mxCell id="pub-b" value="Public Subnet&#10;10.0.2.0/24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="860" y="400" width="440" height="220" as="geometry" />
        </mxCell>

        <!-- Private Subnet B -->
        <mxCell id="priv-b" value="Private Subnet&#10;10.0.3.0/24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="860" y="660" width="440" height="220" as="geometry" />
        </mxCell>

        <!-- EC2 Instance -->
        <mxCell id="ec2" value="🖥️ EC2&#10;Web Application" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Security Group -->
        <mxCell id="sg" value="🔒 Security Group&#10;HTTP / HTTPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- RDS -->
        <mxCell id="rds" value="🗄️ Amazon RDS&#10;MySQL (Multi-AZ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="740" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="internet" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="igw" target="sg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="sg" target="ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="ec2" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
